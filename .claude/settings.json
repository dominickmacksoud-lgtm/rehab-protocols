{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "shell": "bash",
            "timeout": 150,
            "statusMessage": "Checking repo guardrails"
          }
        ]
      }
    ]
  }
}
