# Normalize line endings. Without this, the generated HTML under protocols/
# churns CRLF<->LF on every Windows checkout and produces unreadable diffs
# across ~950 files.
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.csv   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

*.png   binary
*.svg   text eol=lf
*.pdf   binary
